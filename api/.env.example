# Copie para .env e ajuste.
PORT=3333

# Crie o banco antes:  createdb -U postgres hubpet   (ou CREATE DATABASE hubpet;)
DATABASE_URL=postgres://postgres:0805!@localhost:5432/hubpet

# Segredo de assinatura dos tokens. Gere um valor próprio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=7d

# Origem(ns) do front liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
